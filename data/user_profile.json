  "mistakeQuestions": [
    {
      "id": "py_q1",
      "type": "mcq",
      "title": "Valid Variable Name",
      "title_ar": "تسمية المتغيرات الصحيحة",
      "prompt": "Which of the following is a valid variable identifier in Python?",
      "prompt_ar": "أي مما يلي يعتبر اسماً صالحاً لمتغير في بايثون؟",
      "options": [
        "2fast_coder",
        "user_score",
        "user-name",
        "class"
      ],
      "correctIndex": 1,
      "explanation": "Variable names cannot start with numbers, cannot have hyphens (-), and cannot use reserved keywords like \"class\". \"user_score\" is valid.",
      "explanation_ar": "أسماء المتغيرات لا تبدأ بأرقام، ولا تحتوي على شرطات (-)، ولا تستخدم كلمات محجوزة مثل \"class\". الاسم \"user_score\" صالح."
    },
    {
      "id": "py_q2",
      "type": "output",
      "title": "Type Coercion & Addition",
      "title_ar": "دمج النصوص والأنواع",
      "prompt": "What does this code print?",
      "prompt_ar": "ماذا سيطبع هذا الكود؟",
      "code": "x = 5\ny = \"10\"\nprint(str(x) + y)",
      "options": [
        "15",
        "510",
        "TypeError",
        "5 10"
      ],
      "correctIndex": 1,
      "explanation": "str(5) produces \"5\". Concatenating string \"5\" with string \"10\" produces \"510\".",
      "explanation_ar": "str(5) يحول الرقم 5 إلى نص \"5\". دمج النصين \"5\" + \"10\" ينتج \"510\"."
    },
    {
      "id": "py_q3",
      "type": "fill_blank",
      "title": "Formatted Strings (F-String)",
      "title_ar": "تنسيق النصوص بـ F-String",
      "prompt": "Select the missing prefix token to interpolate the variable inside the string:",
      "prompt_ar": "اختر الرمز المفقود لتضمين المتغير داخل النص:",
      "code": "hero = \"Batman\"\nmsg = __\"Welcome back, {hero}!\"\nprint(msg)",
      "tokens": [
        "f",
        "r",
        "b",
        "str"
      ],
      "correctValue": "f",
      "explanation": "Prefixing a string with \"f\" enables f-strings in Python 3.6+, evaluating expressions in curly brackets {}.",
      "explanation_ar": "وضع البادئة \"f\" قبل النص ينشئ f-string مما يتيح حساب المتغيرات بين القوسين {}."
    },
    {
      "id": "py_q4",
      "type": "bug_hunter",
      "title": "Spot the TypeError",
      "title_ar": "اكتشف خطأ TypeError",
      "prompt": "Which line throws an unhandled TypeError when executed?",
      "prompt_ar": "أي سطر سيتسبب في خطأ TypeError أثناء التشغيل؟",
      "code": "1: age = 25\n2: label = \"Age: \"\n3: result = label + age\n4: print(result)",
      "options": [
        "Line 1",
        "Line 2",
        "Line 3",
        "Line 4"
      ],
      "correctIndex": 2,
      "explanation": "In Python, strings cannot be concatenated with integers using the + operator directly. Line 3 requires str(age).",
      "explanation_ar": "في بايثون لا يمكن جمع نص مع رقم صحيح مباشرة بمعامل الجمع +. السطر 3 يتطلب str(age)."
    },
    {
      "id": "py_q5",
      "type": "reorder",
      "title": "Greeting Flow",
      "title_ar": "ترتيب خطوات الترحيب",
      "prompt": "Arrange the code blocks in logical execution order:",
      "prompt_ar": "رتب أجزاء الكود بالترتيب المنطقي للتشغيل:",
      "blocks": [
        "username = \"Player\"",
        "greeting = f\"Hello {username}!\"",
        "print(greeting)"
      ],
      "correctOrder": [
        0,
        1,
        2
      ],
      "explanation": "First initialize username, then format the greeting, then output with print().",
      "explanation_ar": "أولاً نعرف المتغير، ثم ننسق رسالة الترحيب، ثم نطبعها على الشاشة."
    },
